# Directus connection
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
DIRECTUS_STATIC_TOKEN=your-static-token-here
DIRECTUS_FORM_BOT_TOKEN=your-form-bot-token-here
# The Preview User's static token, used by scripts/set-preview-urls.mjs
DIRECTUS_PREVIEW_TOKEN=your-preview-user-token-here

# Cache revalidation
REVALIDATE_SECRET=your-random-secret-here

# Signs the quote form's anti-bot token. Falls back to REVALIDATE_SECRET.
QUOTE_FORM_SECRET=another-random-secret-here

# Prototypes — controlled by netlify.toml deploy contexts
# Override locally if needed:
# ENABLE_PROTOTYPES=true
